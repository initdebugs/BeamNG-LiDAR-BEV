/.claude
# Runtime logs; the colour-probe dump beside them stays tracked as evidence.
logs/*.log
logs/*.log.*

# Bytecode caches; regenerated by the interpreter.
__pycache__/
*.pyc

# The per-simulator virtualenv (see install_dependencies.bat).
.venv39/

# Throwaway camera captures from tools/capture_cameras.py (96 MB of them
# during one investigation). The two frames that are actual evidence live
# beside the tool as tools/vision_alpha_{bug,fixed}.png.
tools/camera_probe/

# Stereo captures from tools/kerb_experiment.py: 6-13 MB per pair, and
# reproducible by re-running the capture. The verdict they produced lives
# in docs/VISION_ROADMAP.md phase 1.
tools/kerb_data/
